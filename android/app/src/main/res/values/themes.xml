<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hifadhio" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/mint</item>
        <item name="colorPrimaryVariant">@color/success</item>
        <item name="colorOnPrimary">@color/primary_navy</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/primary_navy</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Toolbar Title & Subtitle Styling -->
    <style name="TextAppearance.Hifadhio.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Hifadhio.Toolbar.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mint</item>
    </style>

    <style name="Theme.Hifadhio.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.RoundedTop</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.RoundedTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- BottomNavigationView Styling for Perfect Icon-Text Hierarchy -->
    <style name="Widget.Hifadhio.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">22dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Hifadhio.BottomNavigationView.ActiveIndicator</item>
        <item name="itemIconTint">@color/nav_item_icon_tint</item>
        <item name="itemTextColor">@color/nav_item_text_color</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Hifadhio.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Hifadhio.BottomNav.Inactive</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="android:background">@color/surface</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.Hifadhio.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/mint_soft</item>
        <item name="android:width">44dp</item>
        <item name="android:height">28dp</item>
    </style>

    <style name="TextAppearance.Hifadhio.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Hifadhio.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
