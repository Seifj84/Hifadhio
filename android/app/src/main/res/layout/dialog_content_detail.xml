<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar: Platform, Date, Star, Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_detail_platform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Instagram"
                android:textColor="@color/platform_instagram"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Saved 2 hours ago"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btn_detail_fav"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Favorite"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/amber" />

            <ImageView
                android:id="@+id/btn_detail_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Title of Content Item"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Original Title (if customized) -->
        <TextView
            android:id="@+id/tv_detail_original_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Original: Extracted Title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Extracted Caption / Description -->
        <TextView
            android:id="@+id/tv_detail_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Extracted description..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- Cached Thumbnail / Preview Image (Phase 07 Object Storage) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_detail_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <ImageView
                android:id="@+id/iv_detail_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Thumbnail Preview" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Collection Chip & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_detail_collection"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_library"
                android:text="Inbox" />

            <TextView
                android:id="@+id/tv_detail_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="SAVED"
                android:textColor="@color/primary_navy"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- URL Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_link"
                app:tint="@color/blue" />

            <TextView
                android:id="@+id/tv_detail_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="https://instagram.com/reel/xyz123"
                android:textColor="@color/blue"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btn_detail_copy_url"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Copy Link"
                android:src="@drawable/ic_share"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Notes Card -->
        <LinearLayout
            android:id="@+id/layout_detail_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Why I Saved This"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_detail_edit_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Note"
                    android:textColor="@color/mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No personal notes added yet."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tags Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tags"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_detail_add_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add / Edit Tags"
                android:textColor="@color/mint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_detail_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <!-- Processing Timeline Card -->
        <LinearLayout
            android:id="@+id/layout_detail_processing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Link Status"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_job_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Ready"
                    android:textColor="@color/mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_job_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Page details ready"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_retry_job"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="Tap to retry"
                android:textColor="@color/mint"
                android:textSize="12sp"
                app:icon="@drawable/ic_share"
                app:iconSize="14dp"
                app:iconTint="@color/mint"
                app:strokeColor="@color/mint"
                android:visibility="gone" />

            <!-- User-facing simple progress steps -->
            <LinearLayout
                android:id="@+id/layout_detail_user_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- Collapsible Technical Details / Developer Diagnostics -->
            <TextView
                android:id="@+id/btn_toggle_tech_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="▸ Developer Diagnostics"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_technical_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_tech_worker_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Worker: None"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_tech_error_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/danger"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_tech_storage_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Raw Audit Log:"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_detail_events_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speech Transcript Section (Phase 08) -->
        <LinearLayout
            android:id="@+id/layout_detail_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Speech Transcript"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_transcript_badge_provider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Offline"
                    android:textColor="@color/mint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_transcript_badge_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <ImageButton
                    android:id="@+id/btn_copy_transcript"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy Transcript"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/mint" />
            </LinearLayout>

            <!-- Search-on-Detail Filter Bar (§1181) -->
            <EditText
                android:id="@+id/et_transcript_search"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Search within transcript..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Transcript Full Text -->
            <TextView
                android:id="@+id/tv_detail_transcript_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Dynamic Timestamps Container -->
            <LinearLayout
                android:id="@+id/layout_transcript_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Trigger / Retranscribe Button if missing or failed -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_transcribe_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Transcribe Speech"
                android:textColor="@color/mint"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_notes"
                app:iconSize="14dp"
                app:iconTint="@color/mint"
                app:strokeColor="@color/mint"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Visual Text / OCR Section (Phase 09) -->
        <LinearLayout
            android:id="@+id/layout_detail_ocr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Visual Text (OCR)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ocr_badge_provider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="On-Device"
                    android:textColor="@color/mint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ocr_badge_frames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0 frames"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <ImageButton
                    android:id="@+id/btn_copy_ocr"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy Visual Text"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/mint" />
            </LinearLayout>

            <!-- Search-on-Detail Filter Bar (§1181) -->
            <EditText
                android:id="@+id/et_ocr_search"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Search within visual text..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp" />

            <!-- OCR Full Text -->
            <TextView
                android:id="@+id/tv_detail_ocr_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Dynamic Frame Text / Chips Container -->
            <LinearLayout
                android:id="@+id/layout_ocr_frames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Trigger Button if not yet extracted -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ocr_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Extract Visual Text (OCR)"
                android:textColor="@color/mint"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_notes"
                app:iconSize="14dp"
                app:iconTint="@color/mint"
                app:strokeColor="@color/mint"
                android:visibility="gone" />
        </LinearLayout>

        <!-- AI Enrichment Section (Phase 10) -->
        <LinearLayout
            android:id="@+id/layout_detail_ai_enrichment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_detail_surface"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- AI Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="AI Enrichment"
                    android:src="@drawable/ic_ask"
                    app:tint="@color/mint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="AI Enrichment"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- AI Generated Badge (§790, §1215) -->
                <TextView
                    android:id="@+id/tv_ai_badge_generated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_platform_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="AI GENERATED"
                    android:textColor="@color/mint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Version / Provider Badge -->
                <TextView
                    android:id="@+id/tv_ai_badge_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_platform_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="v1.0.0"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />

                <!-- Copy Summary Action -->
                <ImageButton
                    android:id="@+id/btn_copy_ai_summary"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy AI Summary"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Short Summary -->
            <TextView
                android:id="@+id/tv_ai_summary_short"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Detailed Summary -->
            <TextView
                android:id="@+id/tv_ai_summary_detailed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Key Points Section -->
            <TextView
                android:id="@+id/tv_ai_key_points_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Key Takeaways"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_ai_key_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Entities Mentioned Section -->
            <TextView
                android:id="@+id/tv_ai_entities_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Entities &amp; Tools Mentioned"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_ai_entities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Suggested Tags Section -->
            <TextView
                android:id="@+id/tv_ai_suggested_tags_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Suggested Tags (Tap to add)"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_ai_suggested_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <!-- Suggested Collection Section -->
            <LinearLayout
                android:id="@+id/layout_ai_suggested_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ai_suggested_collection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_accept_collection"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Move to Collection"
                    android:textColor="@color/mint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Reprocess Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_reprocess"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:text="Reprocess with latest prompt"
                android:textColor="@color/mint"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_ask"
                app:iconSize="14dp"
                app:iconTint="@color/mint"
                app:strokeColor="@color/mint" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- Primary Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_open"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open in Browser"
            android:textColor="@color/primary_navy"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/mint"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_open"
            app:iconGravity="textStart"
            app:iconTint="@color/primary_navy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_share"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="@color/text_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_edit_all"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Edit Details"
                android:textColor="@color/text_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Delete Saved Link"
            android:textColor="@color/danger"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/danger" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
